<h1>Login</h1>

<%= form_with url: login_path, local: true do |form| %>
  <% if flash[:alert] %>
    <p style="color: red"><%= flash[:alert] %></p>
  <% end %>

  <div>
    <%= form.label :username %><br>
    <%= form.text_field :username %>
  </div>

  <div>
    <%= form.label :password %><br>
    <%= form.password_field :password, required: true %>
  </div>
  <div>
    <%= form.submit "Log in" %>
  </div>
<% end %>
