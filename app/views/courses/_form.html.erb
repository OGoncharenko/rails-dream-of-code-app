<%= form_with(model: @course) do |form| %>
  <% if course.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@course.errors.count, "error") %> prohibited this course from being saved:</h2>

      <ul>
        <% @course.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :coding_class, {}, { class: 'form-text' } %>
    <%= form.select :coding_class_id, options_from_collection_for_select(@coding_classes, :id, :title),
                    { prompt: 'Select Coding Class' },
                    { class: 'form-control' }
    %>
  </div>

  <div class="form-group">
    <%= form.label :trimester, {}, { class: 'form-text' } %>
    <%= form.select :trimester_id, options_from_collection_for_select(@trimesters, :id, :term_and_year), { prompt: 'Select Trimester' }, { class: 'form-control' } %>
  </div>

  <div class="form-group">
    <%= form.label :max_enrollment, 'Max enrollment', class: 'form-text' %>
    <%= form.number_field :max_enrollment, class: 'form-control' %>
  </div>

  <hr/>
  <%= form.submit class: 'btn btn-primary' %>
  <%= link_to 'Cancel', courses_path(@course), class: 'btn btn-primary ml-2' %>

<% end %>
