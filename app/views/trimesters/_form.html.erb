<%= form_with(model: @trimester) do |form| %>
  <% if @trimester.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@trimester.errors.count, "error") %> prohibited this trimester from being saved:</h2>

      <ul>
        <% @trimester.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :term, {}, {class: 'form-tex'} %>
    <%= form.text_field :term, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :year, {}, { class: 'form-tex' } %>
    <%= form.number_field :year, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :start_date, {}, { class: 'form-tex' } %>
    <%= form.date_field :start_date, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :end_date, {}, { class: 'form-tex' } %>
    <%= form.date_field :end_date, class: 'form-control' %>
  </div>

    <div class="form-group">
      <%= form.label :application_deadline, {}, { class: 'form-tex' } %>
      <%= form.date_field :application_deadline, class: 'form-control' %>
    </div>

  <hr />
  <%= form.submit class: 'btn btn-primary' %>
  <%= link_to 'Cancel', trimesters_path(trimester), class: 'btn btn-primary' %>

<% end %>
